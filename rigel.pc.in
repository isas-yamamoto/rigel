prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: rigel
Description: Rigid and Indexed Granular-data Engine Library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lrigel -lpthread
Cflags: -I${includedir}
